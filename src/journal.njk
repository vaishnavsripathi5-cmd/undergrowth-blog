---
layout: base.njk
title: Journal
permalink: /journal/
---

<section class="wrap page-section">
  <div class="section-head">
    <span class="eyebrow">FIELD JOURNAL</span>
    <h1>Journal</h1>
    <p>Observations, wildlife encounters, and stories from the field.</p>
  </div>

  <div class="entries">
    {% set journalPosts = collections.posts | reverse %}

    {% for post in journalPosts %}
      {% if post.data.type == "Journal" %}
        <article class="entry">
          <span class="eyebrow">
            {{ post.data.location or "Field Notes" }}
          </span>

          <h2>
            <a href="{{ post.url }}">{{ post.data.title }}</a>
          </h2>

          {% if post.data.excerpt %}
            <p>{{ post.data.excerpt }}</p>
          {% endif %}

          <a class="link-quiet" href="{{ post.url }}">
            Read journal →
          </a>
        </article>
      {% endif %}
    {% else %}
      <p>No journal entries yet.</p>
    {% endfor %}
  </div>
</section>
